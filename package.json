{
  "name": "guia-aroeira",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run import:data:check && npm run import:transit:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:data": "node scripts/import-establishments.mjs",
    "import:data:check": "node scripts/import-establishments.mjs --check",
    "import:transit": "node scripts/import-transit.mjs",
    "import:transit:check": "node scripts/import-transit.mjs --check"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "latest",
    "react-dom": "latest",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
